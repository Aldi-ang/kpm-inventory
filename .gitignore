# Firebase CLI's local build cache — regenerated per-machine, not meaningful to version control
.firebase/

# graphify: regenerable per-file extraction cache, not meaningful to version control
graphify-out/cache/

# graphify: daily snapshot folders, regenerated by `graphify update .`
# The live graph at graphify-out/*.json is versioned; a dated copy of it every day is not.
graphify-out/2*/

# generated by tools/make-preview.mjs — 240KB of inlined dist CSS, derived from a build.
# Regenerate with `node tools/make-preview.mjs`; never review it in a diff.
tools/theme-preview.html
