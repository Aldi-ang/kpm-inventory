{
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:20128/v1",
    "ANTHROPIC_MODEL": "cc/claude-opus-5"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"D:/APP DEVELOPMENT/kpm inventory main FILES/kpm-inventory-main/.claude/PROGRESS.md\"",
            "commandWindows": "Get-Content \"D:\\APP DEVELOPMENT\\kpm inventory main FILES\\kpm-inventory-main\\.claude\\PROGRESS.md\" -Raw -Encoding UTF8",
            "timeout": 5,
            "statusMessage": "Reading where we left off..."
          },
          {
            "type": "command",
            "command": "cat \"D:/APP DEVELOPMENT/kpm inventory main FILES/kpm-inventory-main/.claude/session-start-context.md\"",
            "commandWindows": "Get-Content \"D:\\APP DEVELOPMENT\\kpm inventory main FILES\\kpm-inventory-main\\.claude\\session-start-context.md\" -Raw -Encoding UTF8",
            "timeout": 5,
            "statusMessage": "Loading KPM standing context (Caveman + Karpathy + A-Brain)..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"D:/APP DEVELOPMENT/kpm inventory main FILES/kpm-inventory-main/.claude/pre-compact-context.md\"",
            "commandWindows": "Get-Content \"D:\\APP DEVELOPMENT\\kpm inventory main FILES\\kpm-inventory-main\\.claude\\pre-compact-context.md\" -Raw -Encoding UTF8",
            "timeout": 5,
            "statusMessage": "Telling the summariser what to keep..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/APP DEVELOPMENT/kpm inventory main FILES/kpm-inventory-main/.claude/context-watch.mjs\"",
            "timeout": 15,
            "statusMessage": "Measuring how full the context is..."
          },
          {
            "type": "command",
            "command": "node \"D:/APP DEVELOPMENT/kpm inventory main FILES/kpm-inventory-main/.claude/plan-quota.mjs\"",
            "timeout": 15,
            "statusMessage": "Measuring how full the context is..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"D:/APP DEVELOPMENT/kpm inventory main FILES/kpm-inventory-main/.claude/check-progress.mjs\" \"D:/APP DEVELOPMENT/kpm inventory main FILES/kpm-inventory-main\"",
            "timeout": 15,
            "statusMessage": "Checking the progress note is current..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/ASUS/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/ASUS/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}