{
  "permissions": {
    "ask": [
      "Edit(**/.claude/skills/alucard/SKILL.md)",
      "Write(**/.claude/skills/alucard/SKILL.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/cloud-start.mjs\"",
            "timeout": 480,
            "statusMessage": "Cloud only: fetching A-Brain, graphify, memory..."
          },
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PROJECT_DIR}/.claude/PROGRESS.md\"",
            "timeout": 5,
            "statusMessage": "Reading where we left off..."
          },
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PROJECT_DIR}/.claude/session-start-context.md\"",
            "timeout": 5,
            "statusMessage": "Loading KPM standing context (Caveman + Karpathy + A-Brain)..."
          },
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR}/../A-Brain\" ] || exit 0; node \"${CLAUDE_PROJECT_DIR}/../A-Brain/automation/vault-gap.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking the vault is not falling behind the code..."
          },
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR}/../A-Brain\" ] || exit 0; node \"${CLAUDE_PROJECT_DIR}/../A-Brain/automation/lessons-health.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking Alucard can still learn..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PROJECT_DIR}/.claude/pre-compact-context.md\"",
            "timeout": 5,
            "statusMessage": "Telling the summariser what to keep..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/context-watch.mjs\"",
            "timeout": 15,
            "statusMessage": "Measuring how full the context is..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/plan-quota.mjs\"",
            "timeout": 15,
            "statusMessage": "Measuring how full the context is..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/check-progress.mjs\" \"${CLAUDE_PROJECT_DIR}\"",
            "timeout": 15,
            "statusMessage": "Checking the progress note is current..."
          },
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR}/../A-Brain\" ] || exit 0; node \"${CLAUDE_PROJECT_DIR}/../A-Brain/automation/lessons-flush.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking a lesson was written..."
          },
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR}/../A-Brain\" ] || exit 0; node \"${CLAUDE_PROJECT_DIR}/../A-Brain/automation/wiki-graph-refresh.mjs\"",
            "timeout": 120,
            "statusMessage": "Keeping the vault's recall graph current..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Workflow|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR}/../A-Brain\" ] || exit 0; node \"${CLAUDE_PROJECT_DIR}/../A-Brain/automation/fanout-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR}/../A-Brain\" ] || exit 0; node \"${CLAUDE_PROJECT_DIR}/../A-Brain/automation/heredoc-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR}/../A-Brain\" ] || exit 0; node \"${CLAUDE_PROJECT_DIR}/../A-Brain/automation/graphify-answer-hook.mjs\" search",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${CLAUDE_PROJECT_DIR}/../A-Brain\" ] || exit 0; node \"${CLAUDE_PROJECT_DIR}/../A-Brain/automation/graphify-answer-hook.mjs\" read",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
