{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kpm-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--host"
      ],
      "port": 5173,
      "url": "https://localhost:5173",
      "autoPort": true
    },
    {
      "name": "theme-lab",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/theme-lab-server.mjs"
      ],
      "port": 4180,
      "url": "http://localhost:4180"
    },
    {
      "name": "ponder-lab",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--config",
        "tools/ponder-lab.config.mjs",
        "--port",
        "4190",
        "--strictPort",
        "--host"
      ],
      "port": 4190,
      "url": "http://localhost:4190"
    },
    {
      "name": "kpm-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--host"
      ],
      "port": 4173,
      "url": "https://localhost:4173",
      "autoPort": true
    },
    {
      "name": "kpm-preview-http",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--mode",
        "httpdev",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174,
      "url": "http://localhost:4174"
    },
    {
      "name": "kpm-dev-http",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--mode",
        "httpdev",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174,
      "url": "http://localhost:5174"
    },
    {
      "name": "demo-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--mode",
        "httpdev",
        "--outDir",
        "dist-demo",
        "--port",
        "4195",
        "--strictPort"
      ],
      "port": 4195,
      "url": "http://localhost:4195"
    }
  ]
}
