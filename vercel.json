{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://cello-inventory-manager.firebaseapp.com/__/auth/:path*"
    }
  ],
  "functions": {
    "api/demo-reset.js": { "includeFiles": "demo/seed.json", "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/demo-reset", "schedule": "5 17 * * *" }
  ]
}
